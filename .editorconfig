root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,h,hpp,cc}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.py]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.conf]
indent_size = 4

[{Dockerfile,*.Dockerfile}]
indent_size = 4

[Makefile]
indent_style = tab
